---
import '../styles/global.css';
import {
  profile, interests, news, publications, me, experience, education,
} from '../data/site';

const description = 'Yair Amar: research on deep learning for speech and on coding agents under security policy.';
// 24x24 icon paths for the contact links, keyed by link label.
const icons: Record<string, string> = {
  Email: 'M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm1 2.4V17h16V7.4l-8 5.3-8-5.3ZM5.6 7 12 11.3 18.4 7H5.6Z',
  GitHub: 'M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z',
  LinkedIn: 'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z',
};
const initials = profile.name.split(' ').map((p) => p[0]).join('');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.name}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={profile.name} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="backdrop" aria-hidden="true">
      <img id="pano" src="/hike.webp" alt="" width="1600" height="381" />
    </div>
    <div class="layout">
      <aside class="profile">
        {profile.headshot ? (
          <img class="headshot" src={profile.headshot} alt={`Portrait of ${profile.name}`} width="176" height="176" />
        ) : (
          <div class="headshot placeholder" aria-hidden="true">{initials}</div>
        )}
        <h1>{profile.name}</h1>
        <p class="title">{profile.title.map((t, i) => <>{i > 0 && <br />}{t}</>)}</p>
        <ul class="links">
          {profile.links.map((l) => (
            <li>
              <svg class="link-icon" viewBox="0 0 24 24" role="img" aria-label={l.label}><path d={icons[l.label]} /></svg>
              <a href={l.href}>{l.text}</a>
            </li>
          ))}
        </ul>
      </aside>

      <main>
        <section id="about">
          {profile.bio.map((p) => <p>{p}</p>)}
        </section>

        <section id="interests">
          <h2>Research interests</h2>
          <ul class="chips">
            {interests.map((i) => <li>{i.href ? <a href={i.href}>{i.label}</a> : <span>{i.label}</span>}</li>)}
          </ul>
        </section>

        <section id="news">
          <h2>News</h2>
          <ul class="news">
            {news.map((n) => (
              <li><span class="date">{n.date}</span><span set:html={n.html} /></li>
            ))}
          </ul>
        </section>

        <section id="publications">
          <h2>Publications</h2>
          <ol class="pubs">
            {publications.map((p) => (
              <li id={p.id}>
                <p class="pub-title">{p.title}</p>
                <p class="authors">
                  {p.authors.map((a, i) => (
                    <>
                      {a.replace('*', '') === me ? <strong>{a}</strong> : a}
                      {i < p.authors.length - 1 ? ', ' : ''}
                    </>
                  ))}
                </p>
                <p class="venue">{p.venue}, {p.year}</p>
                {p.note && <p class="note">{p.note}</p>}
                <p class="pub-links">
                  {p.links.map((l) => <a href={l.href}>{l.label}</a>)}
                </p>
              </li>
            ))}
          </ol>
        </section>

        <section id="experience">
          <h2>Experience</h2>
          <ul class="entries">
            {experience.map((e) => (
              <li class="with-icon">
                <span class="entry-icon">{e.icon && <img src={e.icon} alt="" width="40" height="40" loading="lazy" />}</span>
                <div class="entry-body">
                  <div class="entry-head">
                    <span class="entry-title">{e.title}{e.org && <span class="org">, {e.org}</span>}</span>
                    {e.when && <span class="when">{e.when}</span>}
                  </div>
                  {e.detail && <p class="detail">{e.detail}</p>}
                </div>
              </li>
            ))}
          </ul>
        </section>

        <section id="education">
          <h2>Education</h2>
          <ul class="entries">
            {education.map((e) => (
              <li>
                <div class="entry-head">
                  <span class="entry-title">{e.title}{e.org && <span class="org">, {e.org}</span>}</span>
                  {e.when && <span class="when">{e.when}</span>}
                </div>
                {e.detail && <p class="detail">{e.detail}</p>}
              </li>
            ))}
          </ul>
        </section>

        <footer>Last updated {new Date().toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })}</footer>
      </main>
    </div>
    <script is:inline>
      // Pan the panorama from left to right as the page scrolls.
      (() => {
        const img = document.getElementById('pano');
        if (!img || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        let queued = false;
        const update = () => {
          queued = false;
          const max = document.documentElement.scrollHeight - innerHeight;
          const progress = max > 0 ? Math.min(scrollY / max, 1) : 0;
          const range = Math.max(img.offsetWidth - innerWidth, 0);
          img.style.transform = `translate3d(${-progress * range}px, ${-progress * 40}px, 0)`;
        };
        const queue = () => { if (!queued) { queued = true; requestAnimationFrame(update); } };
        addEventListener('scroll', queue, { passive: true });
        addEventListener('resize', queue);
        if (img.complete) update(); else img.addEventListener('load', update);
      })();
    </script>
  </body>
</html>
