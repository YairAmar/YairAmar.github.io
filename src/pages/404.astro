---
import '../styles/global.css';
import { profile, seo } from '../data/site';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found | {profile.name}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="backdrop" aria-hidden="true">
      <img src="/hike-1080.webp" alt="" width="4527" height="1080" />
    </div>
    <main class="notfound">
      <h1>Page not found</h1>
      <p>This page doesn't exist. Head back to the <a href={seo.url}>home page of {profile.name}</a>.</p>
    </main>
  </body>
</html>
