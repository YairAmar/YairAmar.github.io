---
import '../styles/global.css';
import { profile, seo } from '../data/site';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found | {profile.name}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="backdrop" aria-hidden="true">
      <img src="/hike-1080.webp" alt="" width="4527" height="1080" />
    </div>
    <main class="notfound">
      <h1>Page not found</h1>
      <p>This page doesn't exist. Head back to the <a href={seo.url}>home page of {profile.name}</a>.</p>
    </main>
  </body>
</html>
